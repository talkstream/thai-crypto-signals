{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "typescript pinned to the TS 7 RC (pre-release) — review each bump.",
      "matchPackageNames": ["typescript"],
      "rangeStrategy": "pin"
    }
  ]
}
